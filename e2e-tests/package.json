  "main": "index.js",
  "scripts": {
    "test": "cypress open",
    "k6:smoke": "k6 run k6/scenarios/smoke.js",
    "k6:browse": "k6 run k6/scenarios/browse.js",
    "k6:chat": "k6 run k6/scenarios/chat.js",
