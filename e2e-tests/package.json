    "cypress-cucumber-preprocessor": "^4.3.1",
    "dotenv": "^16.4.7",
    "playwright-bdd": "^9.2.0",
    "prettier": "^3.9.5",
    "prettier-plugin-gherkin": "^4.0.0",
    "typescript": "^5.8.3"
  },
